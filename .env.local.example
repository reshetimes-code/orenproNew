# Copy this file to .env.local and fill in real values (never commit .env.local).

# GitHub Personal Access Token, fine-grained, scoped ONLY to this repo,
# with "Contents: Read and write" permission.
GITHUB_TOKEN=

# owner/repo, e.g. reshetimes-code/orenproNew
GITHUB_REPO=reshetimes-code/orenproNew

# Branch the admin panel commits to
GITHUB_BRANCH=master

# Password to log into /admin
ADMIN_PASSWORD=
